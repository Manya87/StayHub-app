# -----------------------------------------------------------------------------
# StayHub Unified .gitignore
# -----------------------------------------------------------------------------

# --- Node / Next.js / Frontend ---
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions
**/.next/
**/out/
**/dist/
**/build/
**/.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Testing / Logs ---
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment Variables ---
.env*
!.env.example

# --- Java / Spring Boot / Maven ---
**/target/
HELP.md
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- IDEs & Editors ---
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
*.code-workspace

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# --- OS / Misc ---
.DS_Store
Thumbs.db
*.pem
