# ==========================================
# StayHub - Environment Configuration Sample
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=stayhub_db
POSTGRES_USER=stayhub_admin
POSTGRES_PASSWORD=stayhub_secret_pass
POSTGRES_PORT=5432
DB_HOST=localhost

# Redis Cache & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Backend Service
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# API Gateway Service
GATEWAY_PORT=8082

# Frontend Application
VITE_API_BASE_URL=http://localhost:8082
VITE_APP_NAME=StayHub
PORT=5173

# AWS & S3 Configuration (Optional for Document/Media uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key
AWS_SECRET_ACCESS_KEY=mock-secret-key
AWS_S3_BUCKET_NAME=stayhub-documents
